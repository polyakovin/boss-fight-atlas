{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subtitle",
    "variant",
    "summary",
    "overview",
    "learning",
    "category",
    "readTime",
    "demo",
    "steps",
    "mistakes",
    "designNotes",
    "story",
    "adaptation",
    "distinction",
    "lensNotes",
    "examples",
    "reviewStatus",
    "sourceVersion"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "overview": {
      "type": "string",
      "minLength": 1
    },
    "combatFeel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "intro", "variants"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "tuning", "connection"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
              "label": { "type": "string", "minLength": 1 },
              "tuning": { "type": "string", "minLength": 1 },
              "connection": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mechanicId", "body"],
                "properties": {
                  "mechanicId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  },
                  "body": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "learning": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "readTime": {
      "type": "string",
      "minLength": 1
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "timeline",
        "step",
        "phaseNames",
        "phaseDescriptions",
        "boss",
        "player",
        "danger",
        "locked",
        "safe",
        "reducedMotion",
        "diagramDescription"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "timeline": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "phaseNames": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "phaseDescriptions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boss": {
          "type": "string",
          "minLength": 1
        },
        "player": {
          "type": "string",
          "minLength": 1
        },
        "danger": {
          "type": "string",
          "minLength": 1
        },
        "locked": {
          "type": "string",
          "minLength": 1
        },
        "safe": {
          "type": "string",
          "minLength": 1
        },
        "reducedMotion": {
          "type": "string",
          "minLength": 1
        },
        "gamePlayerHealth": { "type": "string", "minLength": 1 },
        "gameBossHealth": { "type": "string", "minLength": 1 },
        "gamePlaying": { "type": "string", "minLength": 1 },
        "gameWon": { "type": "string", "minLength": 1 },
        "gameLost": { "type": "string", "minLength": 1 },
        "gameHit": { "type": "string", "minLength": 1 },
        "gameStrike": { "type": "string", "minLength": 1 },
        "diagramDescription": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mistakes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "designNotes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "distinction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lensNotes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "body"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "game",
          "boss",
          "screenshot",
          "screenshotSource",
          "body",
          "video",
          "videoDurationSeconds"
        ],
        "properties": {
          "dimension": {
            "enum": ["2D", "3D"]
          },
          "game": {
            "type": "string",
            "minLength": 1
          },
          "boss": {
            "type": "string",
            "minLength": 1
          },
          "screenshot": {
            "type": "string",
            "format": "https-url"
          },
          "screenshotSource": {
            "type": "string",
            "format": "https-url"
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "video": {
            "type": "string",
            "format": "https-url"
          },
          "videoDurationSeconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "reviewStatus": {
      "enum": ["needs-review", "reviewed"]
    },
    "sourceVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mechanic lesson translation"
}
