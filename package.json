{
  "name": "boss-fight-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run check:repo && npm run validate && npm test && npm run build",
    "sync:mechanics-index": "node scripts/sync-mechanics-index.mjs",
    "new:mechanic": "node scripts/new-mechanic.mjs",
    "new:lens": "node scripts/new-lens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "lucide": "1.47.0",
    "prettier": "3.9.8"
  }
}
